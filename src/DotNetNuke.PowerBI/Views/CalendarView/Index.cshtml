@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<DotNetNuke.PowerBI.Models.PowerBICalendarView>
@using System.Web.Mvc
@using System.Web.WebPages.Html
@using DotNetNuke.PowerBI.Models
@using DotNetNuke.Web.Mvc.Helpers
@using DotNetNuke.Web.Client.ClientResourceManagement
@using SelectListItem = System.Web.Mvc.SelectListItem
@{
    ClientResourceManager.RegisterStyleSheet(Dnn.DnnPage, "https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.9.0/fullcalendar.min.css", 10, "DnnPageHeaderProvider");
    ClientResourceManager.RegisterStyleSheet(Dnn.DnnPage, "~/DesktopModules/MVC/PowerBIEmbedded/css/module.css", 10, "DnnPageHeaderProvider");
    ClientResourceManager.RegisterScript(Dnn.DnnPage, "~/DesktopModules/MVC/PowerBIEmbedded/scripts/powerbi.min.js", 20);
    ClientResourceManager.RegisterScript(Dnn.DnnPage, "https://npmcdn.com/es6-promise@3.2.1", 18);
    // NOTE: jQuery is already provided by DNN/the active skin. Re-loading jQuery (and jQuery UI)
    // from a CDN here overrides the page's jQuery instance and breaks Bootstrap 5 based skins
    // such  as Tabler (their plugins, e.g. popover/dropdowns, get detached). FullCalendar 3.9 works
    // fine with the jQuery already present on the page.
    ClientResourceManager.RegisterScript(Dnn.DnnPage, "https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.21.0/moment.min.js", 20);
    ClientResourceManager.RegisterScript(Dnn.DnnPage, "https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.9.0/fullcalendar.min.js", 21);
    ClientResourceManager.RegisterScript(Dnn.DnnPage, "https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.9.0/locale-all.js", 22);


}
 
<div class="powerbiCalendarView" id="powerbiCalendarView_@Dnn.ActiveModule.ModuleID">
    @Html.DropDownList("Mode", ViewBag.Options as SelectList, new { @class = "form-control drop m-b" })

    @if (Model != null && !string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div id="errorWrapper">
            <h2>@Dnn.LocalizeString("ErrorTitle")</h2>
            <p>@Model.ErrorMessage</p>
        </div>
    }
    else
    {
        <div id="pbiCalendarError_@Dnn.ActiveModule.ModuleID" class="pbi-calendar-error" style="display:none;"></div>
        <div id="calendar_@Dnn.ActiveModule.ModuleID" class="fc fc-unthemed fc-ltr"></div>
        <div class="history">
            <h1>Refresh history</h1>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Dataset</th>
                        <th>Workspace</th>
                        <th>Capacity</th>
                        <th>Start time</th>
                        <th>End time</th>
                        <th>Refresh Type</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="pbiHistoryBody_@Dnn.ActiveModule.ModuleID"></tbody>
            </table>
            <div class="pages">
                <ul class="pagination" id="pbiHistoryPagination_@Dnn.ActiveModule.ModuleID"></ul>
            </div>
        </div>
        <script>
            (function () {
                var moduleId = parseInt('@Dnn.ActiveModule.ModuleID', 10);
                var context = {
                    PortalId: parseInt('@Dnn.ActiveModule.PortalID', 10),
                    ModuleId: moduleId,
                    TabId: parseInt('@Dnn.ActiveModule.TabID', 10)
                };
                var pageSize = 10;
                var errorText = @Html.Raw(Json.Encode(Dnn.LocalizeString("Error"))) || 'An error occurred while loading the calendar.';

                var $container = $('#powerbiCalendarView_' + moduleId);
                var $mode = $container.find('[name="Mode"]');
                var $calendar = $('#calendar_' + moduleId);
                var $historyBody = $('#pbiHistoryBody_' + moduleId);
                var $pagination = $('#pbiHistoryPagination_' + moduleId);
                var $error = $('#pbiCalendarError_' + moduleId);

                var sf = $.ServicesFramework(moduleId);
                var serviceRoot = sf.getServiceRoot('PowerBI/Services') + 'Calendar/';
                var currentCid = ($mode.val() || '-1');

                function ajaxHeaders() {
                    return {
                        'PortalId': context.PortalId,
                        'ModuleId': context.ModuleId,
                        'TabId': context.TabId,
                        'RequestVerificationToken': sf.getAntiForgeryValue()
                    };
                }

                function updateUrlParameter(uri, key, value) {
                    var i = uri.indexOf('#');
                    var hash = i === -1 ? '' : uri.substr(i);
                    uri = i === -1 ? uri : uri.substr(0, i);

                    var re = new RegExp("([?&])" + key + "=.*?(&|$)", "i");
                    var separator = uri.indexOf('?') !== -1 ? "&" : "?";
                    if (uri.match(re)) {
                        uri = uri.replace(re, '$1' + key + "=" + value + '$2');
                    } else {
                        uri = uri + separator + key + "=" + value;
                    }
                    return uri + hash;
                }

                // Reflect the current workspace in the address bar WITHOUT reloading the page.
                function setCidInUrl(cid) {
                    if (window.history && window.history.replaceState) {
                        var newUrl = updateUrlParameter(window.location.href, 'cid', cid);
                        window.history.replaceState(null, '', newUrl);
                    }
                }

                function showError() {
                    if ($error.length) {
                        $error.text(errorText).show();
                    }
                }

                function clearError() {
                    if ($error.length) {
                        $error.hide().empty();
                    }
                }

                function initCalendar() {
                    $calendar.fullCalendar({
                        defaultView: 'agendaWeek',
                        defaultDate: '2006-01-02',
                        firstDay: 1,
                        minTime: '00:00:00',
                        maxTime: '23:59:00',
                        timeFormat: "HH:mm",
                        slotLabelFormat: "HH:mm",
                        editable: false,
                        selectable: false,
                        eventLimit: true,
                        eventLimitText: "More",
                        droppable: false,
                        dragRevertDuration: 0,
                        events: [],
                        contentHeight: 'auto',
                        header: {},
                        views: {
                            agendaTwoDay: {
                                type: 'agenda',
                                duration: { days: 1 }
                            },
                            agendaWeek: {
                                titleFormat: 'MMMM',
                                columnFormat: 'dddd'
                            }
                        },
                        allDaySlot: false,
                        eventRender: function (eventObj, $el) {
                            var tooltip = eventObj.title || '';
                            if (eventObj.description) {
                                tooltip += (tooltip ? '\n' : '') + eventObj.description;
                            }
                            if (tooltip) {
                                $el.attr('title', tooltip);
                            }
                        }
                    });
                }

                function loadSchedule(cid) {
                    $.ajax({
                        url: serviceRoot + 'GetSchedule',
                        type: 'GET',
                        async: true,
                        data: { cid: cid },
                        dataType: 'json',
                        headers: ajaxHeaders()
                    }).done(function (data) {
                        var schedules = (data && (data.schedules || data.Schedules)) || [];
                        $calendar.fullCalendar('removeEventSources');
                        $calendar.fullCalendar('addEventSource', schedules);
                    }).fail(function (xhr) {
                        if (window.console) { console.error(xhr); }
                        showError();
                    });
                }

                function loadHistory(cid, page) {
                    $.ajax({
                        url: serviceRoot + 'GetHistory',
                        type: 'GET',
                        async: true,
                        data: { cid: cid, page: page, pageSize: pageSize },
                        dataType: 'json',
                        headers: ajaxHeaders()
                    }).done(function (data) {
                        renderHistory(data);
                    }).fail(function (xhr) {
                        if (window.console) { console.error(xhr); }
                        showError();
                    });
                }

                function renderHistory(data) {
                    var history = (data && (data.history || data.History)) || [];
                    var currentPage = (data && (data.currentPage || data.CurrentPage)) || 1;
                    var totalPages = (data && (data.totalPages || data.TotalPages)) || 0;

                    $historyBody.empty();
                    $.each(history, function (i, h) {
                        var $tr = $('<tr>');
                        $tr.append($('<td>').text(h.dataset || h.Dataset || ''));
                        $tr.append($('<td>').text(h.workspace || h.Workspace || ''));
                        $tr.append($('<td>').text(h.capacity || h.Capacity || ''));
                        $tr.append($('<td>').text(h.startTime || h.StartTime || ''));
                        $tr.append($('<td>').text(h.endTime || h.EndTime || ''));
                        $tr.append($('<td>').text(h.refreshType || h.RefreshType || ''));
                        $tr.append($('<td>').text(h.status || h.Status || ''));
                        $historyBody.append($tr);
                    });

                    renderPagination(currentPage, totalPages);
                }

                function renderPagination(currentPage, totalPages) {
                    $pagination.empty();
                    for (var i = 1; i <= totalPages; i++) {
                        var $li = $('<li>', { 'class': 'page-item' + (i === currentPage ? ' active' : '') });
                        var $a = $('<a>', { 'class': 'page-link', href: '#', text: i });
                        (function (targetPage) {
                            $a.on('click', function (e) {
                                e.preventDefault();
                                loadHistory(currentCid, targetPage);
                            });
                        })(i);
                        $li.append($a);
                        $pagination.append($li);
                    }
                }

                $mode.on('change', function () {
                    currentCid = $(this).val();
                    setCidInUrl(currentCid);
                    clearError();
                    loadSchedule(currentCid);
                    loadHistory(currentCid, 1);
                });

                $(function () {
                    initCalendar();
                    loadSchedule(currentCid);
                    loadHistory(currentCid, 1);
                });
            })();
        </script>
    }
</div>
